# Local demonstration ONLY. DO NOT deploy this sample unchanged.
APP_ENV=local
# Set APP_ENV=production and DEMO_MODE=0 for managed identity-only auth.
DEMO_MODE=1
DATABASE_URL=postgresql+psycopg://demand:demand@postgres:5432/demandatlas
FORECAST_URL=http://forecast:8001
FORECAST_SERVICE_TOKEN=change-me-before-deployment
TOKEN_ENGINEER=demo-engineer
TOKEN_ANALYST=demo-analyst
TOKEN_CATEGORY=demo-category
TOKEN_DIRECTOR=demo-director
TOKEN_OBSERVER=demo-observer
RATE_LIMIT_PER_MINUTE=240

# v0.4.0: enforced for POST/PUT/PATCH, including chunked payloads
MAX_REQUEST_BYTES=41943040
